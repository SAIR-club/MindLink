{
  "name": "mindlink",
  "version": "0.0.0",
  "private": true,
  "description": "MindLink: the learning application built on Episteme.",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @mindlink/app build:web",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --force && pnpm --filter @mindlink/app typecheck:web",
    "pretest": "tsc -b --force && pnpm --filter @mindlink/app build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "simple-git-hooks",
    "mindlink": "pnpm --filter @mindlink/app serve",
    "modules:check": "tsc -b && node apps/mindlink/dist/blocks/check-library.js",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm modules:check"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm format:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "6.0.9",
    "dotenv": "^16.4.7",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.16.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "vue": "3.5.43"
  }
}
