{
  "name": "@mindlink/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MindLink's launcher: Episteme's service composed with the Learn scene and every MindLink feature.",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "default": "./dist/blocks/index.js"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "default": "./dist/project/index.js"
    }
  },
  "bin": {
    "mindlink": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && vite build web",
    "typecheck": "tsc -b && vue-tsc -p web/tsconfig.json",
    "build:web": "vite build web",
    "typecheck:web": "vue-tsc -p web/tsconfig.json",
    "dev:web": "vite web",
    "serve": "tsc -b && vite build web && node dist/cli.js serve"
  },
  "dependencies": {
    "@episteme/domain-learn": "workspace:*",
    "@mindlink/platform": "workspace:*",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "vite": "7.3.6",
    "vue-tsc": "3.3.11"
  }
}
