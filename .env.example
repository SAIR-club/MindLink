# MindLink Configuration Example
# Copy this file to .env to customize local configuration.

# Path to the cognitive graph storage file (SQLite database)
# Defaults to $EPISTEME_DATA_DIR/learn.db or ~/.episteme/learn.db
# EPISTEME_FILE=./data/learn.db
# EPISTEME_DATA_DIR=./data

# Optional path to a seed topic JSON file to initialize the graph
# EPISTEME_TOPIC_FILE=./topics/my-topic.json

# Web server port and bind address
PORT=4321
HOST=127.0.0.1

# Path to chromium-based browser executable for automated UI driving
# BROWSER_PATH=
